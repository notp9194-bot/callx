<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f2f5">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#005c97"
        android:title="Contact Dhundo"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="#ffffff"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CallX ID daalo (e.g. callx_abc12345)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Button
            android:id="@+id/btn_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dhundho"
            android:backgroundTint="#008069"
            android:layout_marginTop="16dp"/>
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#667781"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/ll_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#ffffff"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_result_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#111b21"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tv_result_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#667781"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
            <Button
                android:id="@+id/btn_send_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact Request Bhejo"
                android:backgroundTint="#008069"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
